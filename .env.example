# 环境变量模板（无密钥）。复制为仓库根目录 .env 后填写。
# MCP 相关项请从 Map_project/.env 迁入同一文件（不要放到 mcp_server/.env）。

# Chat / Agent
DEEPSEEK_API_KEY=
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash

# RAG Embedding
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Milvus（可选）
MILVUS_URI=http://localhost:19530

# Store 长期记忆（可选；Postgres。与 Checkpointer 短期记忆并存；未配置则仅短期）
# STORE_POSTGRES_URI=postgresql://user:password@host:5432/dbname?sslmode=disable
# STORE_USER_ID=demo-user

# MCP（自 Map_project 迁入）
SERPER_API_KEY=
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
EMAIL_USER=
EMAIL_PASS=

# LangSmith（可选；对齐教程仓：设环境变量后 LangChain/Agent 自动上报 traces）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-cs-agent
